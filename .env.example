# ============================================================
# CDC Pipeline Environment Configuration Template
# ============================================================
# Copy this file to .env and adjust values for your environment
# DO NOT commit .env to version control - it may contain secrets

# ============================================================
# PostgreSQL Source Database
# ============================================================
POSTGRES_HOST=postgres-source
POSTGRES_PORT=5432
POSTGRES_DB=sourcedb
POSTGRES_USER=sourceuser
POSTGRES_PASSWORD=sourcepass

# ============================================================
# Data Generator Configuration
# ============================================================
DB_HOST=postgres-source
DB_PORT=5432
DB_NAME=sourcedb
DB_USER=sourceuser
DB_PASSWORD=sourcepass

# Generation behavior
GENERATION_MODE=continuous       # Options: 'initial', 'continuous'
GENERATION_INTERVAL=5            # Seconds between data generation cycles
INITIAL_USERS=100               # Number of users to create initially
INITIAL_ORDERS=500              # Number of orders to create initially
INITIAL_DEVICES=150             # Number of devices to create initially

# ============================================================
# Kafka Configuration
# ============================================================
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181

# Kafka topics
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true

# ============================================================
# Zookeeper Configuration
# ============================================================
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000

# ============================================================
# Schema Registry Configuration
# ============================================================
SCHEMA_REGISTRY_HOST_NAME=schema-registry
SCHEMA_REGISTRY_KAFKASTORE_BOOTSTRAP_SERVERS=kafka:29092
SCHEMA_REGISTRY_LISTENERS=http://0.0.0.0:8081

# ============================================================
# Debezium Connect Configuration
# ============================================================
DEBEZIUM_BOOTSTRAP_SERVERS=kafka:29092
DEBEZIUM_GROUP_ID=1
DEBEZIUM_CONFIG_STORAGE_TOPIC=debezium_connect_configs
DEBEZIUM_OFFSET_STORAGE_TOPIC=debezium_connect_offsets
DEBEZIUM_STATUS_STORAGE_TOPIC=debezium_connect_statuses

# ============================================================
# Spark CDC Application Configuration
# ============================================================
# Kafka bootstrap servers for Spark
# IMPORTANT: Use different values depending on where Spark runs:
#   - 'localhost:9092' when running Spark locally (outside Docker)
#   - 'kafka:29092' when running Spark inside Docker container
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Storage locations (change for production deployments)
CHECKPOINT_LOCATION=/tmp/spark_checkpoints
WAREHOUSE_LOCATION=/tmp/cdc_warehouse
DLQ_LOCATION=/tmp/cdc_dead_letter

# Spark configuration
SPARK_APP_NAME=ProductionCDCPipeline
SPARK_MASTER=local[*]              # Use 'yarn' or 'spark://host:port' for cluster mode
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g

# Processing configuration
SPARK_PROCESSING_INTERVAL=30       # Seconds between micro-batches
SPARK_MAX_OFFSETS_PER_TRIGGER=1000 # Max records per trigger

# ============================================================
# Kafka UI Configuration
# ============================================================
KAFKA_UI_CLUSTERS_0_NAME=local
KAFKA_UI_CLUSTERS_0_BOOTSTRAPSERVERS=kafka:29092
KAFKA_UI_CLUSTERS_0_SCHEMAREGISTRY=http://schema-registry:8081

# ============================================================
# Logging Configuration
# ============================================================
LOG_LEVEL=INFO
KAFKA_LOG_LEVEL=WARN
SPARK_LOG_LEVEL=WARN
ZOOKEEPER_LOG_LEVEL=WARN

# ============================================================
# Network Configuration
# ============================================================
NETWORK_NAME=cdc-network

# ============================================================
# Port Mappings (for external access)
# ============================================================
POSTGRES_EXTERNAL_PORT=5432
KAFKA_EXTERNAL_PORT=9092
KAFKA_UI_PORT=8080
SCHEMA_REGISTRY_PORT=8081
DEBEZIUM_CONNECT_PORT=8083
ZOOKEEPER_PORT=2181
